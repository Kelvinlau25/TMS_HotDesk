<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TMS_HotDesk</RootNamespace>
    <AssemblyName>TMS_HotDesk</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Library\Library.Common\Library.Common.csproj" />
    <ProjectReference Include="Library\Library.Control.Base\Library.Control.Base.csproj" />
    <ProjectReference Include="Library\Library.Root\Library.Root.csproj" />
    <ProjectReference Include="Library\Library.SQLServer\Library.SQLServer.csproj" />
    <ProjectReference Include="Library\Library.Oracle\Library.Oracle.csproj" />
    <ProjectReference Include="Library\Library.Database\Library.Database.csproj" />
    <ProjectReference Include="Library\Library.WebFormsAdapter\Library.WebFormsAdapter.csproj" />
  </ItemGroup>

  <!-- Exclude VB files from C# compilation -->
  <ItemGroup>
    <Compile Remove="**\*.vb" />
    <Content Remove="**\*.vb" />
  </ItemGroup>

  <!-- Exclude old packages folder, build artifacts, and library obj/bin dirs -->
  <ItemGroup>
    <Compile Remove="packages\**" />
    <Content Remove="packages\**" />
    <None Remove="packages\**" />
    <Compile Remove="HotDesk_PRAI\**" />
    <Compile Remove="HotDesk_SPICE\**" />
    <Content Remove="HotDesk_PRAI\**" />
    <Content Remove="HotDesk_SPICE\**" />
    <Compile Remove="Library\**" />
    <Content Remove="Library\**" />
    <None Remove="Library\**" />
  </ItemGroup>

  <!-- Legacy WebForms files have been removed; aspx/ascx/master content includes are no longer needed -->


</Project>
