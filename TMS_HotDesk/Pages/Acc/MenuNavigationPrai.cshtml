@Html.AntiForgeryToken()

<div id="pnlhd" class="pnlhd">
    @if (Model.SeatData != null)
    {
        @for (int i = 0; i < Model.SeatData.Rows.Count; i++)
        {
            var row = Model.SeatData.Rows[i];
            var seatStatus = row["SEAT_STATUS"].ToString().ToUpper();
            var hiddenValue = "0";
            if (seatStatus == "Y")
            {
                hiddenValue = "1 " + row["SEAT_STATUS"].ToString();
            }
            <input type="hidden" id="hi@(i + 1)" class="hi@(i + 1)" value="@hiddenValue" />
        }
    }
</div>

<label id="lblTime" style=" font-weight:bold" class="lbldate" ></label>
<div class="header">
    <h2>TMS PRAI Hot Desking System</h2>
</div>
<div class="wrap">
    <div class="mtest center">
        <div class="btnlist">
            <input type='button' id='warehouse1' value='West Wing' class="dropbtn" />
            <input type='button' id='warehouse2' value='East Wing' class="dropbtn" />
            <input type='button' id='warehouse3' value='Ai Home' class="dropbtn" />
            <input type='button' id='checkInList' value='Last Person' class="dropbtn" />
            <input type='button' id='checkInList2' value='Arm Record' class="dropbtn" />
        </div>
        
        <div class="btnlist right absolute"> 
            <button type="button" id="btnCheck" class="dropbtn " onclick="popupwindow('txtStaffID','txtStaffName'); return false;">Check In/Out</button>
        </div>
    </div>
    <div class="wrapdrop"><h2></h2> </div>
    <div class="wrap hidedrop">
         
        <div class="dropdown">
            <div style="background:white; width:727px; z-index:100; position:absolute; top:130px;">&nbsp; 
                <input type="text" id="txtStaffID" class="txtReadOnly txtStaffID txt" style="BORDER-WIDTH:0PX;COLOR:black;BACKGROUND-COLOR:Transparent; font-size:22PX; width:200px;font-weight:bold;" value="" disabled />&nbsp; &nbsp; 
                <input type="text" id="txtStaffName" class="txtReadOnly txtStaffName txt" style="BORDER-WIDTH:0PX;COLOR:black;BACKGROUND-COLOR:Transparent; font-size:22PX; font-weight:bold; width:350px;" value="" disabled />
                <label id="userID" class="LabelChange" style=" color:white;font-size:18px;  padding-left:100px;"></label>
            </div>
         
            <div id="dropdowncontent1" class="dropdown-content dc" >
            
                <div id="pnlhd1" class="pnlhd"><div class="label8a"></div>
                    @if (Model.SeatData != null)
                    {
                        @for (int idx = 1; idx <= Model.SeatData.Rows.Count; idx++)
                        {
                            bool isInPanel1 = (idx >= 1 && idx <= 28 && idx != 26) || (idx >= 66 && idx <= 71);
                            if (!isInPanel1) { continue; }
                            var row = Model.SeatData.Rows[idx - 1];
                            var isOccupied = row["SEAT_STATUS"].ToString().ToUpper() == "Y";
                            if (isOccupied)
                            {
                                <input type="button" id="label@(idx)" class="label@(idx)" value="@row["SEAT_OWNER"].ToString()" />
                            }
                            else
                            {
                                <input type="button" id="label@(idx)" class="label@(idx)" value="" disabled style="display:none;" />
                            }
                        }
