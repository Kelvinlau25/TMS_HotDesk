@page
@model TMS_HotDesk.Pages.Acc.PopUp.FirstArmPraiModel
@using System.Data

<!DOCTYPE html>
<html>
<head>
    <link href="/css_new/TMSAccess.css" rel="stylesheet" type="text/css" />
</head>
<body class="framebody">
    <br /><br />
    @if (Model.Data.Rows.Count == 0)
    {
        <div style="text-align:center; font-weight:bold; color:white;">Record Not Found</div>
    }
    else
    {
        <table width="100%">
            <tr class="OutTable">
                <th style="text-align:center; vertical-align:middle; width:30%;">STAFF NAME</th>
                <th style="text-align:center; vertical-align:middle; width:30%;">FIRST SCAN</th>
                <th style="text-align:center; vertical-align:middle; width:20%;">DATE</th>
                <th style="text-align:center; vertical-align:middle; width:20%;">DOOR</th>
            </tr>
            @{ int rowIndex = 0; }
            @foreach (DataRow row in Model.Data.Rows)
            {
                <tr class="@(rowIndex % 2 == 0 ? "OutTable" : "OutTable1")">
                    <td style="text-align:left; vertical-align:middle;">@row["STAFFNAME"]</td>
                    <td style="text-align:left; vertical-align:middle;">@row["TRANSTIME"]</td>
                    <td style="text-align:left; vertical-align:middle;">@row["Transdate"]</td>
                    <td style="text-align:left; vertical-align:middle;">@row["DOOR"]</td>
                </tr>
                rowIndex++;
            }
        </table>
    }
</body>
</html>
