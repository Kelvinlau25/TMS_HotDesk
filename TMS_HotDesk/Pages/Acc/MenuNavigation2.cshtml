<script type="text/javascript" >

function testing(checktype,staffName,seatName)
{
    fetch('/Acc/MenuNavigation2?handler=Testing', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
        },
        body: JSON.stringify({ checktype: checktype, staffName: staffName, seatName: seatName })
    })
    .then(function(res) { return res.json(); })
    .then(function(response) { OnSuccess(response); })
    .catch(function(err) { alert('Error: ' + err); });
}

function OnSuccess(response) 
{setTimeout(function() { location.reload(); }, 60000);alert(response);}

