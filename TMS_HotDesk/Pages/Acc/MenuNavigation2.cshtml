<script type="text/javascript">

    var popupWindow=null;

  function popupwindow(ID, Name) {
     if( document.getElementById('txtStaffName').value == "")
     {
        var w = 800;
        var h = 600;
        var left = (screen.width/2)-(w/2);
        var top = (screen.height/2)-(h/2);
        popupWindow = window.open('/Acc/PopUp/ListSpice?itm1=' + ID + '&itm2=' + Name,'PopUp', 'directories=no,titlebar=no,toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=800,height=600,top='+top+', left='+left +'');
    
     }
     
     else
     {  
        document.getElementById('txtStaffName').value = "";
        document.getElementById('txtStaffID').value = "";
      }
   };
   
function parent_disable() {
if(popupWindow && !popupWindow.closed)
popupWindow.focus();
}
</script>
  
