@page
@model TMS_HotDesk.Pages.LogModel
@using System.Data
@{
    Layout = "_Layout";
    ViewData["Title"] = "Log";
}

@section Head {
    <link href="/css/Detail.css" rel="stylesheet" type="text/css" />
    <link href="/css/PenGroup.css" rel="stylesheet" type="text/css" />
    <link href="/css/prodSystem.css" rel="stylesheet" type="text/css" />
    <link href="/css/stylesheetmsdn.css" rel="stylesheet" type="text/css" />
    <script src="/js/jquery-1.7.1.min.js" type="text/javascript"></script>
    <script src="/js/common.js" type="text/javascript"></script>
    <script src="/js/commonsearch.js" type="text/javascript"></script>
}

<div id="divDesc">@Html.Raw(Model.Description)</div><br />
<table width="100%">
    <tr>
        <td>
            <table width="100%">
                <thead>
                    <tr class="title_bar">
                        <th style="width:20%; text-align:left; vertical-align:middle;">Field</th>
                        <th style="width:20%; text-align:left; vertical-align:middle;">Old Value</th>
                        <th style="width:20%; text-align:left; vertical-align:middle;">New Value</th>
                        <th style="width:20%; text-align:left; vertical-align:middle;">User</th>
                        <th style="text-align:left; vertical-align:middle;">Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow row in Model.LogData.Rows)
                    {
                        <tr class="content">
                            <td style="text-align:left; vertical-align:middle;">@row["FieldName"]</td>
                            <td style="text-align:left; vertical-align:middle;">@row["B4Update"]</td>
                            <td style="text-align:left; vertical-align:middle;">@row["AFUpdate"]</td>
                            <td style="text-align:left; vertical-align:middle;">@row["UpdateBy"]</td>
                            <td style="text-align:left; vertical-align:middle;">@row["UpdatedDate"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </td>
    </tr>
</table>
<div style="width:100%;text-align:center">
    <button type="button" onclick="window.open('','_self','');window.close();">Close</button>
</div>
